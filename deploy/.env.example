# deploy/.env — docker compose 가 읽는다. 이 파일을 복사해 .env 로 만들고 값을 채운다.
# ⚠️ .env 는 커밋 금지 (.gitignore 등록됨). EC2 에서는 chmod 600.

# ─── compose ───────────────────────────────────────────
# EC2: https (nginx + certbot 함께 기동) / 로컬 검증: 비워 둔다
COMPOSE_PROFILES=
# EC2: <계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/challenge-server:latest / 로컬: 비워 두면 challenge-server:local
APP_IMAGE=

# ─── HTTPS (EC2 만) ─────────────────────────────────────
DOMAIN=api.example.com
CERTBOT_EMAIL=you@example.com

# ─── 필수 ──────────────────────────────────────────────
DB_USERNAME=challenge
# openssl rand -base64 24
DB_PASSWORD=
# openssl rand -base64 48 (최소 32바이트)
JWT_SECRET=

# ─── 외부 연동 — 비어 있으면 서버는 뜨지만 해당 기능이 조용히 NoOp 이 된다 ──
# 기동 로그의 "활성/비활성" 한 줄로 확인할 것.
KAKAO_ADMIN_KEY=
# deploy/secrets/fcm.json 을 두면 컨테이너 안에서 이 경로로 보인다.
FCM_CREDENTIALS_PATH=/run/secrets/fcm.json
# 유료 티어 키여야 한다 (ADR-0013). 두 값이 모두 있어야 켜진다.
GEMINI_API_KEY=
GEMINI_MODEL=

# ─── 선택 ──────────────────────────────────────────────
# SWAGGER_ENABLED=true
